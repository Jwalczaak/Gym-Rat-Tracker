{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm run test:run)",
      "Bash(npm run test:run *)",
      "Bash(npm run verify)",
      "Bash(npm run build)",
      "Bash(npm run format)",
      "Bash(npx tsc -b --noEmit)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit -m *)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)"]
  }
}
